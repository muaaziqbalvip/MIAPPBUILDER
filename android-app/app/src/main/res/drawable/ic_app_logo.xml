<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    
    <!-- Background: Deep Premium Dark with rounded aesthetic -->
    <path
        android:fillColor="#07080C"
        android:pathData="M0,0h108v108h-108z" />

    <!-- Subtle radial glow background -->
    <path
        android:pathData="M14,14 h80 a16,16 0 0 1 16,16 v48 a16,16 0 0 1 -16,16 h-80 a16,16 0 0 1 -16,-16 v-48 a16,16 0 0 1 16,-16 z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="50"
                android:startColor="#2A080C"
                android:endColor="#0E1017" />
        </aapt:attr>
    </path>

    <!-- Outer border badge with red glow -->
    <path
        android:strokeWidth="1.5"
        android:strokeColor="#E50914"
        android:pathData="M18,18 h72 a12,12 0 0 1 12,12 v48 a12,12 0 0 1 -12,12 h-72 a12,12 0 0 1 -12,-12 v-48 a12,12 0 0 1 12,-12 z" />

    <!-- Left Pillar of M (Deep Red with Highlight) -->
    <path
        android:pathData="M28,26 L42,26 L42,82 L28,82 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="28"
                android:startY="26"
                android:endX="42"
                android:endY="82"
                android:startColor="#E50914"
                android:endColor="#8B0000" />
        </aapt:attr>
    </path>

    <!-- Right Pillar of M (Deep Red with Shadow) -->
    <path
        android:pathData="M66,26 L80,26 L80,82 L66,82 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="66"
                android:startY="26"
                android:endX="80"
                android:endY="82"
                android:startColor="#E50914"
                android:endColor="#6B0000" />
        </aapt:attr>
    </path>

    <!-- Center Diagonal Ribbon (Netflix/Marvel 3D Ribbon overlap) -->
    <path
        android:pathData="M28,26 L42,26 L80,82 L66,82 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="28"
                android:startY="26"
                android:endX="80"
                android:endY="82"
                android:startColor="#FF2633"
                android:endColor="#B30006" />
        </aapt:attr>
    </path>

    <!-- 3D Ribbon Drop Shadow -->
    <path
        android:pathData="M28,26 L34,35 L34,82 L28,82 Z"
        android:fillColor="#33000000" />

    <!-- Top Gloss / Chrome Sheen -->
    <path
        android:pathData="M28,26 L80,26 L74,32 L34,32 Z"
        android:fillColor="#4DFFFFFF" />

</vector>
